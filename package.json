{
  "name": "windowclip",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "windowclip": "./src/cli.ts"
  },
  "scripts": {
    "build:clicks": "swiftc -O -target arm64-apple-macosx15.0 cmd/clicks/main.swift -o cmd/clicks/clicks",
    "build:windows": "swiftc -O -target arm64-apple-macosx15.0 cmd/windows/main.swift -o cmd/windows/windows",
    "build:recorder": "swiftc -O -target arm64-apple-macosx15.0 cmd/recorder/main.swift -o cmd/recorder/recorder",
    "build:app": "./app/build.sh",
    "build": "pnpm run build:clicks && pnpm run build:windows && pnpm run build:recorder && pnpm run build:app",
    "cli": "bun run src/cli.ts",
    "test": "bun run test/run-tests.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
