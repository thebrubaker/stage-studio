<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>Windowclip</string>
	<!-- FROZEN at io.digitalpine.windowclip. This string is the key TCC files
	     every permission grant under. Changing it makes macOS treat the app as
	     brand new and forget Screen Recording + Microphone.

	     It changed exactly once, deliberately: the 2026-07-30 rename from
	     "Stage Studio" (io.digitalpine.stage-studio) to Windowclip. That change
	     forfeited the old grants on purpose — the owner wanted to walk the
	     first-run permission flow again from scratch and record it. There is no
	     second reason. It does not change again. -->
	<key>CFBundleIdentifier</key>
	<string>io.digitalpine.windowclip</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Windowclip</string>
	<key>CFBundleDisplayName</key>
	<string>Windowclip</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>2</string>
	<key>LSMinimumSystemVersion</key>
	<!-- Must match the -target on every swiftc invocation (app/build.sh and the
	     package.json build:* scripts). This key is only a claim; the binaries'
	     LC_BUILD_VERSION is what dyld enforces. They disagreed once. -->
	<string>15.0</string>
	<!-- Agent app: no Dock icon, no menu bar. The pill and picker are the whole UI. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- The app spawns cmd/recorder, which captures mic audio; TCC attributes the
	     child's request to this bundle as the responsible process. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Windowclip records your microphone as the voiceover track of a screen recording.</string>
</dict>
</plist>
